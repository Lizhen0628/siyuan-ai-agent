{
  "name": "siyuan-agent",
  "version": "0.4.0",
  "description": "SiYuan Agent - AI assistant plugin for SiYuan Note",
  "main": "index.js",
  "scripts": {
    "dev": "webpack --mode development",
    "build": "webpack --mode production",
    "deploy": "webpack --mode production && rsync -av --delete dist/ \"$SIYUAN_WORKSPACE/data/plugins/siyuan-agent/\"",
    "deploy:local": "npm run build && rsync -av --delete dist/ \"$HOME/SiYuanKnowledgeBase/data/plugins/siyuan-agent/\""
  },
  "keywords": [
    "siyuan",
    "agent",
    "pi",
    "ai"
  ],
