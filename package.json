  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Lizhen0628/siyuan-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Lizhen0628/siyuan-agent/issues"
  },
  "homepage": "https://github.com/Lizhen0628/siyuan-agent#readme",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.5.0",
    "mini-css-extract-plugin": "^2.10.2",
    "process": "^0.11.10",
    "siyuan": "1.2.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  }
